# Configuration example; the root .env file is not loaded automatically.
# Use only local demo values here; put actual values in the ignored .env file.
POSTGRES_DB=school_admission
POSTGRES_USER=school_admission
POSTGRES_PASSWORD=replace-with-a-local-development-password

# .NET environment variables (export before starting the API).
ASPNETCORE_URLS=http://localhost:8080
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=school_admission;Username=school_admission;Password=replace-with-a-local-development-password
# Override the default frontend origin (no trailing slash or path).
Cors__AllowedOrigins__0=http://localhost:5173
# Positive integer seconds; defaults to 600 when unset and is validated at API startup.
HOLD_DURATION_SECONDS=600

# Planned browser-facing API URL. Frontend wiring is scheduled for step 16.
API_BASE_URL=http://localhost:8080

# Optional schema tests; use a test-server account with CREATE DATABASE permission.
# The fixture creates and removes only its own uniquely named database.
# SCHEMA_TEST_CONNECTION_STRING=Host=localhost;Port=5432;Database=postgres;Username=schema_test;Password=replace-with-a-test-password
