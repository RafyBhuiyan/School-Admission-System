# Docker Compose reads these settings from the root .env automatically.
# Use only local demo values here; put actual values in the ignored .env file.
# Single-quote passwords containing dollar signs to preserve them literally.
POSTGRES_DB=school_admission
POSTGRES_USER=school_admission
POSTGRES_PASSWORD=replace-with-a-local-development-password
FRONTEND_PORT=5173
API_PORT=8080
# Private administrator credential (at least 32 characters); never put it in frontend config.
# Class creation is disabled until configured. Generate a unique value for your installation.
Admin__AccessKey=
# Internal listener ports; Compose uses each value for its listener and port mapping.
API_HTTP_PORT=8080
FRONTEND_HTTP_PORT=8080
# Optional internal probe override for custom listeners; normally derived automatically.
# HealthCheck__BaseUrl=http://localhost:8080
# Optional browser origin override; otherwise Compose derives http://localhost:<FRONTEND_PORT>.
# FRONTEND_ORIGIN=http://localhost:5173

# .NET environment variables for local execution (export before starting the API).
# Local dotnet execution does not read .env automatically. Compose constructs its own internal database address.
# The container defaults to ASPNETCORE_HTTP_PORTS=8080 on all interfaces; do not pass a localhost-only URL into it.
ASPNETCORE_URLS=http://localhost:8080
# Local password-based PostgreSQL does not need Kerberos/GSSAPI negotiation.
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=school_admission;Username=school_admission;Password=replace-with-a-local-development-password;GSS Encryption Mode=Disable
# Local API origin override (no trailing slash or path). Compose uses FRONTEND_ORIGIN instead.
Cors__AllowedOrigins__0=http://localhost:5173
# Positive integer seconds; defaults to 600 when unset and is validated at API startup.
HOLD_DURATION_SECONDS=600
# Expiration worker: one bounded batch per interval; both settings are validated at startup.
Expiration__IntervalMilliseconds=1000
Expiration__BatchSize=100

# Browser-facing API URL consumed by frontend container startup to generate public config.json.
# For local Vite execution, edit Frontend/public/config.json instead; exporting this alone does not rewrite it.
API_BASE_URL=http://localhost:8080

# Optional schema tests; use a test-server account with CREATE DATABASE permission.
# The fixture creates and removes only its own uniquely named database.
# SCHEMA_TEST_CONNECTION_STRING=Host=localhost;Port=5432;Database=postgres;Username=schema_test;Password=replace-with-a-test-password
